{
  "ai.mode": "cloud",
  "ai.provider": "claude",
  "ai.web_search": true,
  "audio.agc": true,
  "audio.agc_max_gain_db": 24,
  "audio.prefer_echo_cancel": false,
  "coaching.enabled": false,
  "context.cloud": [
    "system"
  ],
  "context.local": [
    "system"
  ],
  "dictation.cleanup": "simple",
  "dictation.commands": "simple",
  "dictation.idle_timeout": "60s",
  "dictation.insert": "auto",
  "dictation.notes_dir": "~/Documents/Footman notes",
  "dictation.stop_phrases": [
    "stop dictation",
    "end dictation",
    "that's all"
  ],
  "dictation.terminal_mode": true,
  "history.retention_days": 30,
  "history.transcripts": true,
  "input.command.key": "Shift+F8",
  "input.command.mode": "hold",
  "input.dictate.key": "F8",
  "input.dictate.mode": "hold",
  "input.microphone": "default",
  "input.wake_word": true,
  "jobs.code_edits.new_branch": true,
  "jobs.code_edits.show_diff": true,
  "jobs.max_concurrent": 2,
  "jobs.worker": "claude-code",
  "memory.enabled": false,
  "permissions.act": "auto",
  "permissions.action_log": true,
  "permissions.action_log_retention_days": 90,
  "permissions.destructive": "confirm",
  "permissions.outward": "confirm",
  "permissions.read": "auto",
  "personas.default": "ashford",
  "personas.listening": [
    "ashford"
  ],
  "replies.notify": true,
  "replies.quiet": false,
  "replies.quiet_hours": "",
  "replies.speak": "when-voice",
  "speech.followup.enabled": true,
  "speech.followup.timeout": "8s",
  "speech.stt.accelerator": "auto",
  "speech.stt.engine": "auto",
  "speech.stt.model": "auto",
  "speech.tts.engine": "persona",
  "speech.unload_after": "10m",
  "speech.vad.min_silence": 0.5,
  "speech.wake.boost": 3,
  "speech.wake.debug": false,
  "speech.wake.earcon": true,
  "speech.wake.extra": [],
  "speech.wake.threshold": 0.05,
  "speech.wake.verify": true,
  "user.language": "en",
  "user.location": "",
  "user.name": "",
  "version": 1,
  "web.listen": "127.0.0.1:7878"
}
